{
  "name": "@mtg/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w --preserveWatchOutput",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
