{
  "name": "@mtg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsoa spec-and-routes && tsx watch --env-file=.env src/server.ts",
    "routes": "tsoa spec-and-routes",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsoa spec-and-routes && tsc --noEmit -p tsconfig.check.json",
    "test": "tsoa spec-and-routes && vitest run",
    "token": "tsx --env-file=.env src/scripts/token.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts latest",
    "db:rollback": "tsx --env-file=.env src/db/migrate.ts rollback",
    "db:make": "tsx --env-file=.env src/db/migrate.ts make",
    "lint": "eslint --max-warnings 0 .",
    "db:export": "tsx --env-file=.env src/scripts/db-export.ts",
    "db:import": "tsx --env-file=.env src/scripts/db-import.ts",
    "test:coverage": "tsoa spec-and-routes && vitest run --coverage"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mtg/shared": "*",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "inversify": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "up-fetch": "^2.6.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
