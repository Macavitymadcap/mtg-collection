NODE_ENV=local
PORT=3400
DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=mtg
DB_USER=app
DB_PASSWORD=app
# Local only. Generate a real one for any shared environment.
JWT_SECRET=local-only-change-me-please
LOG_LEVEL=debug
CORS_ORIGINS=
# Sign-in (Better Auth). AUTH_SECRET: `openssl rand -base64 32`
AUTH_SECRET=local-only-not-secret-change-me-0123456789
AUTH_BASE_URL=http://localhost:3000
# GitHub OAuth app (see README). Leave blank for a read-only site.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_GITHUB_ALLOWLIST=
